<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de árbol para ubicaciones FSM -->
        <record id="view_daruclima_fsm_location_tree" model="ir.ui.view">
            <field name="name">daruclima.fsm.location.tree</field>
            <field name="model">daruclima.fsm.location</field>
            <field name="arch" type="xml">
                <list string="Ubicaciones FSM">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="city"/>
                    <field name="state_id"/>
                    <field name="contact_id"/>
                    <field name="order_count"/>
                    <field name="equipment_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario para ubicaciones FSM -->
        <record id="view_daruclima_fsm_location_form" model="ir.ui.view">
            <field name="name">daruclima.fsm.location.form</field>
            <field name="model">daruclima.fsm.location</field>
            <field name="arch" type="xml">
                <form string="Ubicación FSM">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_orders" type="object"
                                    class="oe_stat_button" icon="fa-tasks">
                                <field name="order_count" widget="statinfo" string="Órdenes"/>
                            </button>
                            <button name="action_view_equipment" type="object"
                                    class="oe_stat_button" icon="fa-cogs">
                                <field name="equipment_count" widget="statinfo" string="Equipos"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Cliente">
                                <field name="partner_id" required="1"/>
                                <field name="contact_id" domain="[('parent_id', '=', partner_id)]"/>
                                <field name="phone"/>
                                <field name="email"/>
                            </group>
                            <group string="Estado">
                                <field name="active"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <group string="Dirección">
                            <group>
                                <field name="street"/>
                                <field name="street2"/>
                                <field name="city"/>
                            </group>
                            <group>
                                <field name="state_id"/>
                                <field name="zip"/>
                                <field name="country_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Descripción e Información de Acceso">
                                <group>
                                    <field name="description" nolabel="1" placeholder="Descripción de la ubicación..."/>
                                </group>
                                <group string="Información de Acceso">
                                    <field name="access_info" nolabel="1" placeholder="Instrucciones especiales para acceder a la ubicación..."/>
                                </group>
                            </page>
                            <page string="Geolocalización">
                                <group>
                                    <field name="partner_latitude"/>
                                    <field name="partner_longitude"/>
                                </group>
                            </page>
                            <page string="Equipos">
                                <field name="equipment_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="brand"/>
                                        <field name="model"/>
                                        <field name="status"/>
                                        <field name="next_maintenance_date"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_post="True"/>
                </form>
            </field>
        </record>

        <!-- Acción para ubicaciones FSM -->
        <record id="action_daruclima_fsm_location" model="ir.actions.act_window">
            <field name="name">Ubicaciones FSM</field>
            <field name="res_model">daruclima.fsm.location</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Vista de árbol para equipos FSM -->
        <record id="view_daruclima_fsm_equipment_tree" model="ir.ui.view">
            <field name="name">daruclima.fsm.equipment.tree</field>
            <field name="model">daruclima.fsm.equipment</field>
            <field name="arch" type="xml">
                <list string="Equipos FSM">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="location_id"/>
                    <field name="brand"/>
                    <field name="model"/>
                    <field name="status"/>
                    <field name="next_maintenance_date"/>
                    <field name="order_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario para equipos FSM -->
        <record id="view_daruclima_fsm_equipment_form" model="ir.ui.view">
            <field name="name">daruclima.fsm.equipment.form</field>
            <field name="model">daruclima.fsm.equipment</field>
            <field name="arch" type="xml">
                <form string="Equipo FSM">
                    <header>
                        <button name="action_schedule_maintenance" string="Programar Mantenimiento"
                                type="object" class="btn-primary"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_orders" type="object"
                                    class="oe_stat_button" icon="fa-tasks">
                                <field name="order_count" widget="statinfo" string="Órdenes"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Cliente y Ubicación">
                                <field name="partner_id" required="1"/>
                                <field name="location_id" domain="[('partner_id', '=', partner_id)]"/>
                                <field name="code"/>
                            </group>
                            <group string="Información del Equipo">
                                <field name="product_id"/>
                                <field name="brand"/>
                                <field name="model"/>
                                <field name="serial_number"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Fechas y Mantenimiento">
                                <group>
                                    <group string="Fechas Importantes">
                                        <field name="purchase_date"/>
                                        <field name="installation_date"/>
                                        <field name="warranty_expiry"/>
                                    </group>
                                    <group string="Mantenimiento">
                                        <field name="maintenance_frequency"/>
                                        <field name="last_maintenance_date"/>
                                        <field name="next_maintenance_date" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Especificaciones Técnicas">
                                <group>
                                    <field name="specifications" nolabel="1" placeholder="Especificaciones técnicas del equipo..."/>
                                </group>
                                <group>
                                    <field name="manual_url"/>
                                </group>
                            </page>
                            <page string="Notas">
                                <field name="notes" nolabel="1" placeholder="Notas adicionales sobre el equipo..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Acción para equipos FSM -->
        <record id="action_daruclima_fsm_equipment" model="ir.actions.act_window">
            <field name="name">Equipos FSM</field>
            <field name="res_model">daruclima.fsm.equipment</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
