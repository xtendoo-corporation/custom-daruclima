<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de árbol para órdenes FSM -->
        <record id="view_daruclima_fsm_order_tree" model="ir.ui.view">
            <field name="name">daruclima.fsm.order.tree</field>
            <field name="model">daruclima.fsm.order</field>
            <field name="arch" type="xml">
                <list string="Órdenes de Trabajo">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="location_id"/>
                    <field name="stage_id"/>
                    <field name="priority" widget="priority"/>
                    <field name="responsible_id"/>
                    <field name="date_scheduled"/>
                    <field name="total_sale" sum="Total Ventas"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario para órdenes FSM -->
        <record id="view_daruclima_fsm_order_form" model="ir.ui.view">
            <field name="name">daruclima.fsm.order.form</field>
            <field name="model">daruclima.fsm.order</field>
            <field name="arch" type="xml">
                <form string="Orden de Trabajo">
                    <header>
                        <button name="action_start_work" string="Iniciar Trabajo"
                                type="object" class="btn-primary"
                                invisible="date_start or is_closed"/>
                        <button name="action_end_work" string="Finalizar Trabajo"
                                type="object"
                                invisible="not date_start or date_end or is_closed"/>
                        <button name="action_create_quotation" string="Crear Presupuesto"
                                type="object"
                                invisible="sale_order_id"/>
                        <button name="action_create_repair_order" string="Crear Orden de Reparación"
                                type="object" class="btn-warning"/>
                        <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_repair_orders" type="object"
                                    class="oe_stat_button" icon="fa-wrench"
                                    invisible="repair_count == 0">
                                <field name="repair_count" widget="statinfo" string="Reparaciones"/>
                            </button>
                            <button name="action_view_quotations" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="quotation_count == 0">
                                <field name="quotation_count" widget="statinfo" string="Presupuestos"/>
                            </button>
                            <button name="action_view_attachments" type="object"
                                    class="oe_stat_button" icon="fa-paperclip">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Adjuntos</span>
                                </div>
                            </button>
                            <button name="action_view_fsm_order" type="object"
                                    class="oe_stat_button" icon="fa-external-link"
                                    invisible="not sale_order_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Orden de Venta</span>
                                </div>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group name="customer_info" string="Información del Cliente">
                                <field name="partner_id" required="1"/>
                                <field name="contact_id" domain="[('parent_id', '=', partner_id)]"/>
                                <field name="location_id" domain="[('partner_id', '=', partner_id)]"/>
                            </group>
                            <group name="service_info" string="Información del Trabajo">
                                <field name="team_id" required="1"/>
                                <field name="responsible_id"/>
                                <field name="priority" widget="priority"/>
                                <field name="date_scheduled"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <group string="Descripción del Trabajo">
                            <field name="description" nolabel="1"
                                   placeholder="Descripción detallada del trabajo a realizar..."/>
                        </group>

                        <notebook>
                            <page string="Personal y Recursos">
                                <group>
                                    <group string="Personal Asignado">
                                        <field name="person_ids" widget="many2many_tags"/>
                                    </group>
                                    <group string="Equipos y Etiquetas">
                                        <field name="equipment_ids" widget="many2many_tags"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Materiales">
                                <field name="material_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="cost_unit"/>
                                        <field name="cost_total"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Tiempo y Control">
                                <group>
                                    <group string="Fechas">
                                        <field name="date_created" readonly="1"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="duration" readonly="1"/>
                                    </group>
                                    <group string="Totales">
                                        <field name="total_cost" readonly="1"/>
                                        <field name="total_sale" readonly="1"/>
                                        <field name="margin" readonly="1"/>
                                        <field name="margin_percent" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Notas">
                                <group>
                                    <field name="internal_note"
                                           placeholder="Notas internas (no visibles para el cliente)"/>
                                    <field name="customer_note"
                                           placeholder="Notas para el cliente"/>
                                </group>
                            </page>

                            <page string="Facturación" invisible="not sale_order_id">
                                <group>
                                    <field name="invoice_status"/>
                                    <field name="sale_order_id"/>
                                </group>
                                <field name="sale_line_ids" readonly="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="product_uom_qty"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal"/>
                                        <field name="invoice_status"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_post="True"/>
                </form>
            </field>
        </record>

        <!-- Vista kanban para órdenes FSM -->
        <record id="view_daruclima_fsm_order_kanban" model="ir.ui.view">
            <field name="name">daruclima.fsm.order.kanban</field>
            <field name="model">daruclima.fsm.order</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column">
                    <field name="stage_id"/>
                    <field name="color"/>
                    <field name="priority"/>
                    <field name="partner_id"/>
                    <field name="responsible_id"/>
                    <field name="date_scheduled"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click" t-att-style="record.color.raw_value and 'border-left: 4px solid %s' % record.color.raw_value or ''">
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Editar</a></t>
                                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Eliminar</a></t>
                                    </div>
                                </div>
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <field name="partner_id"/>
                                            <t t-if="record.responsible_id.raw_value">
                                                <br/><i class="fa fa-user" title="Técnico responsable"/> <field name="responsible_id"/>
                                            </t>
                                            <t t-if="record.date_scheduled.raw_value">
                                                <br/><i class="fa fa-calendar" title="Fecha programada"/> <field name="date_scheduled"/>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="priority" widget="priority"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista calendario para órdenes FSM -->
        <record id="view_daruclima_fsm_order_calendar" model="ir.ui.view">
            <field name="name">daruclima.fsm.order.calendar</field>
            <field name="model">daruclima.fsm.order</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Órdenes"
                          date_start="date_scheduled"
                          color="responsible_id">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="responsible_id"/>
                </calendar>
            </field>
        </record>

        <!-- Acción para órdenes FSM -->
        <record id="action_daruclima_fsm_order" model="ir.actions.act_window">
            <field name="name">Órdenes de Trabajo</field>
            <field name="res_model">daruclima.fsm.order</field>
            <field name="view_mode">kanban,list,form,calendar</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nueva orden de trabajo
                </p>
                <p>
                    Gestione sus órdenes de trabajo de manera eficiente.
                    Asigne técnicos, programe visitas y haga seguimiento del progreso.
                </p>
            </field>
        </record>

    </data>
</odoo>
